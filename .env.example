# ==============================================================================
# Bilingual (Arabic + English) Enterprise RAG with Saudi PDPL Guardrails
# Copy this file to ".env" and paste your FREE Groq API Key.
# ==============================================================================

# 1. LLM Configuration (100% Free Tier via Groq: https://console.groq.com/keys)
LLM_PROVIDER=groq
GROQ_API_KEY=your_free_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Optional: Local Offline LLM via Ollama (set LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 2. Multilingual Embeddings (Arabic + English)
# Options:
#   - sentence_transformers : Local model (best for Local / Docker / HF Spaces 16GB RAM)
#   - huggingface_api       : Free HF Inference API (0 local RAM, best for Render 512MB)
#   - local_hash            : Instant zero-dependency fallback (CI/tests)
EMBEDDING_PROVIDER=sentence_transformers
# Recommended light multilingual model (~470MB) or upgrade to BAAI/bge-m3 (~2.2GB):
EMBEDDING_MODEL=intfloat/multilingual-e5-small
HF_API_TOKEN=

# 3. Vector Store (Qdrant in-memory by default, or paste free Qdrant Cloud URL)
USE_QDRANT=true
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ksa_enterprise_rag

# 4. RAG Chunking & Hybrid Search Defaults
CHUNK_SIZE=650
CHUNK_OVERLAP=100
DEFAULT_TOP_K=5
DEFAULT_VECTOR_WEIGHT=0.6

# 5. Saudi PDPL / SDAIA Guardrails
ENABLE_PII_REDACTION=true
USE_PRESIDIO=false
REDACT_ON_INGEST=false

# 6. Server Settings (Port 7860 is the default for Hugging Face Spaces)
HOST=0.0.0.0
PORT=7860
